# ══════════════════════════════════════════════════════════
# MT5 CONNECTION
# ══════════════════════════════════════════════════════════
MT5_LOGIN=58014074
MT5_PASSWORD="d2&E}Q9h"
MT5_SERVER="FivePercentOnline-Real#TopOneTrader-MT5"

# ══════════════════════════════════════════════════════════
# GLOBAL SYMBOLS & MODE
# ══════════════════════════════════════════════════════════
MODE=live
SYMBOLS=XAUUSD,EURUSD,GBPUSD,GBPJPY,AUDUSD,NZDUSD,USDJPY,NAS100,SP500,XAGUSD,USDCHF,EURJPY,AUDJPY,NZDJPY,US30,DAX40,FTSE100

# ══════════════════════════════════════════════════════════
# PRIMARY: BB-SQUEEZE BREAKOUT (retf.py)
# ══════════════════════════════════════════════════════════
BB_SQ_MAGIC=445566

# Signal detection
BB_PERIOD=20
ATR_PERIOD=14
SQUEEZE_MAX_RATIO=2.0
BREAKOUT_TRIGGER_ATR=0.5
BREAKOUT_LOOKAHEAD=5
TRIGGER_EMBARGO_BARS=20

# Timeframes
BB_RATIO_TF=M30
VOL_REGIME_TF=M30
ATR_TF=M5

# Entry / exit timing
DECISION_BARS=10
HOLD_BARS=40
STOP_R=1.0

# Filter modes
SESSION_FILTER=strict
LONDON_CAUTION=true
VOL_REGIME_FILTER=strict
SQ_FILTER=strict
BS_FILTER_ENABLED=false

# Session hour filters
HOUR_ALLOW_NY=12,13,14,15,16
HOUR_ALLOW_LONDON=7,8,9,10,11
HOUR_ALLOW_ASIAN=0,1,2,3,4,5,6

# Calibration
M30_VR_LOOKBACK=50
M30_BB_MAX=2.5
BREAKPOINTS_FILE=filter_breakpoints.json

# ══════════════════════════════════════════════════════════
# SECONDARY: MA+RSI EXTREME CROSSOVER
# ══════════════════════════════════════════════════════════
SECONDARY_ENABLED=true
SECONDARY_MAGIC=778899
SECONDARY_EXIT=tp2_inv_sl
SECONDARY_LIVE_ALLOW=false
SECONDARY_BROKER_EXITS=false
SECONDARY_ENTRY_USE_TICK=true
SECONDARY_RISK_PERCENT=0.5

# Exit strategy variants:
#   hold_invalidation / fixed_2to1 / tp2_inv_sl / tp1_inv_sl
SECONDARY_SYNTH_STOP_R=1.0
SECONDARY_INVALIDATION_ASSUMED_STOP_R=3.0
SECONDARY_HARD_STOP_R=0.0
SECONDARY_MAX_HOLD_BARS=500

# Which patterns to trade (comment out to use all 6)
# SECONDARY_PATTERNS=MA+RSI_EMA_50_RSI35/65_M15,MA+RSI_SMA_50_RSI35/65_M15

# ══════════════════════════════════════════════════════════
# RISK MANAGEMENT (shared across strategies)
# ══════════════════════════════════════════════════════════
RISK_PER_TRADE_R=1.0
RISK_PER_TRADE_PCT=0.01
MAX_PORTFOLIO_RISK_PCT=2.0
MAX_OPEN_POSITIONS=5
MAX_SAME_SYMBOL=2
MAX_SESSION_RISK_R=3.0

# Lot limits
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=0.50
MAX_LOT_XAUUSD=0.10
MAX_LOT_INDICES=0.10

# Drawdown limits
MAX_DAILY_LOSS_PCT=0.03
MAX_WEEKLY_LOSS_PCT=0.05
MAX_PEAK_DD_PCT=0.05
MAX_PEAK_DRAWDOWN_PCT=0.30

# Costs
COST_BPS=0.7

# ══════════════════════════════════════════════════════════
# DATA / OUTPUT / STATE
# ══════════════════════════════════════════════════════════
DATA_DIR=./data
OUTPUT_DIR=./results
STATE_FILE=bb_sq_state.json
SIGNAL_LOG_FILE=signals.jsonl
TRADE_LEDGER_FILE=trade_ledger.jsonl
TRADE_HISTORY_FILE=trade_history.jsonl
CACHE_TTL=15

# ══════════════════════════════════════════════════════════
# LOGGING / TRACING
# ══════════════════════════════════════════════════════════
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=bb_sq_v7.log

# Signal trace (verbose per-signal logging)
SIGNAL_TRACE=true

# Cycle logging (per-engine-loop stats)
CYCLE_LOG_ENABLED=true
CYCLE_LOG_CONSOLE=true
CYCLE_LOG_EVERY=1
CYCLE_LOG_FILE=cycle_log.jsonl

# ══════════════════════════════════════════════════════════
# TELEGRAM
# ══════════════════════════════════════════════════════════
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN="8520784371:AAFd-NjPb4-AKWVTr5i7H_mtVmJYLo3K0po"
TELEGRAM_CHAT_ID="1121850718"
TELEGRAM_MAX_RETRIES=2
TELEGRAM_RETRY_DELAY=5

# ══════════════════════════════════════════════════════════
# STAGE 3 RESEARCH (exit optimizer)
# ══════════════════════════════════════════════════════════
STAGE3_DATA_DIR=/upload
STAGE3_OUTPUT_DIR=./results/stage3
STAGE3_MAX_SIGNALS=5000
STAGE3_MAX_HOLD_BARS=500
STAGE3_RANDOM_SEED=12345
STAGE3_MIN_WINDOW_BARS=250
STAGE3_ROUND_TRIP_COST=false
STAGE3_CAP_METHOD=truncate
# STAGE3_SYMBOLS=XAUUSD,EURUSD,GBPUSD,GBPJPY,AUDUSD,NZDUSD,USDJPY,NAS100,SP500

# ══════════════════════════════════════════════════════════
# KILL SWITCH
# ══════════════════════════════════════════════════════════
# Set to 1 to pause all trading without stopping the bot
TRADING_KILL_SWITCH=0

# ══════════════════════════════════════════════════════════
# new_regeime_cl.py (ML regime strategy)
# ══════════════════════════════════════════════════════════
TIMEFRAME=M30
RISK_PER_TRADE=0.01
MAX_POSITIONS_PER_SYMBOL=2
MAX_TOTAL_POSITIONS=6
MAX_CONCURRENT_SYMBOLS=4

# SL/TP multipliers (ATR-based)
STOP_LOSS_ATR_MULTIPLIER=1.0
TAKE_PROFIT_ATR_MULTIPLIER=2.0

# Model thresholds
PROBABILITY_THRESHOLD=0.60
MIN_TEST_ACCURACY=0.55
MIN_MODEL_EDGE=0.03
TREND_QUALITY_THRESHOLD=0.00001
EXIT_PROBABILITY_THRESHOLD=0.60
BREAK_STRENGTH_THRESHOLD=0.30
MIN_BREAK_STRENGTH=0.40

# ATR thresholds
MIN_ATR_THRESHOLD=0.0005
MAX_ATR_THRESHOLD=100.0
MAX_ATR_FOR_SIZING=20.0

# Calibration gate
MIN_CALIBRATION_ECE=0.10
CALIBRATION_GATE_ENABLED=true
CALIBRATION_GATE_HOLDOUT_FRAC=0.30
CALIBRATION_GATE_MIN_SAMPLES=200
CALIBRATION_GATE_AUDIT_PATH=calibration_gate_audit.jsonl

# Exit behaviour
DYNAMIC_EXIT_ENABLED=true
MAX_DEVIATION=50
MAX_SLIPPAGE_RETRIES=2

# Confidence-based exit
CONFIDENCE_EXIT_ENABLED=true
CONFIDENCE_EXIT_DROP_RATIO=0.5
CONFIDENCE_EXIT_MIN_HOLD_MIN=10
CONFIDENCE_EXIT_ABSOLUTE_FLOOR=0.20

# Opposite-signal exit (opt-in)
OPPOSITE_SIGNAL_EXIT_ENABLED=false
OPPOSITE_SIGNAL_THRESHOLD=0.60
OPPOSITE_SIGNAL_MIN_HOLD_MIN=5

# Per-symbol/direction filters
DIRECTION_FILTER_DEFAULT_ENABLED=true
DIRECTION_FILTER_MIN_PROB_DEFAULT=0.0
RSI_OVERSOLD_BUY_FLOOR=0.0
RSI_OVERBOUGHT_SELL_FLOOR=0.0

# Trend-based cut thresholds
XAUUSD_CUT_THRESHOLD=-2.2
NAS100_CUT_THRESHOLD=-2.0
US30_CUT_THRESHOLD=-2.0
STRONG_TREND_BIAS=0.001
MODERATE_TREND_BIAS=0.0005
TREND_ALIGNED_MULTIPLIER=1.3
PARTIAL_ALIGN_MULTIPLIER=0.9
AGAINST_TREND_MULTIPLIER=0.6

# Emergency / cooldown
EMERGENCY_CUT_GRACE_MINUTES=5
SCALEOUT_MIN_AGE_MINUTES=45
COOLDOWN_AFTER_CUT_MINUTES=10
MIN_STOP_DISTANCE_PCT=0.0005

# Retraining
RETRAIN_DAYS=3
FIXED_VOLUME=1000.0

# Training parameters
TRAIN_BARS=5000
LABEL_LOOKFORWARD=6
LABEL_MIN_ATR_MOVE=2.0
LABEL_ASYMMETRY_THRESHOLD=0.3
LABEL_MAECAP_ATR=1.0

# Diagnostics
ENTRY_DIAGNOSTICS=false

